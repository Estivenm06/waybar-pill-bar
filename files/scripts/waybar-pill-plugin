#!/usr/bin/env python3
"""Lifecycle and control for the Waybar Pill Bar Omarchy service plugin.

Usage: waybar-pill-plugin mode | start --checkout PATH | serve --checkout PATH | active | reload | toggle | stop |
                          recover | runtime-dir | record-generated PATH...

The plugin's QML service runs `start --checkout PATH`. It stages this helper and the state helper into an immutable,
content-hashed generation under the data directory and launches the detached `serve` backend from there, so a session
can finish restoring files even when Omarchy deletes the checkout right after disabling the plugin. `serve` accepts
the QML service's lease, provisions the checkout (install.sh --provision) while the native desktop stays untouched,
and only then takes over notifications, OSD and the bar. The lease socket's EOF (plugin disabled, removed, or the
shell exiting) ends the session and restores the managed files, then the native desktop."""
import sys

sys.dont_write_bytecode = True  # nothing this helper loads may leave bytecode in a watched plugin directory

import errno  # noqa: E402
import fcntl  # noqa: E402
import hashlib  # noqa: E402
import importlib.machinery  # noqa: E402
import importlib.util  # noqa: E402
import json  # noqa: E402
import os  # noqa: E402
import re  # noqa: E402
import secrets  # noqa: E402
import select  # noqa: E402
import signal  # noqa: E402
import socket  # noqa: E402
import stat  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402
import time  # noqa: E402

PLUGIN_ID = "waybar.pill-bar"
CONFLICTS = ("omarchy.notifications", "omarchy.osd")
NOTIFY_NAME = "org.freedesktop.Notifications"
LEASE_WAIT = 5.0
READY_WAIT = 15.0
LIFECYCLE_WAIT = 120.0
PROVISION_WAIT = 1800.0
SESSION_SOCKETS = ("notifications.sock", "notch-content.sock")
STOP_WAIT = 5.0
MAX_TREE_DEPTH = 32
MAX_TREE_ENTRIES = 20000


class PluginError(Exception):
    pass


def home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(home(), ".local", "state")
    return os.path.join(base, "waybar-notch")


def marker_path():
    return os.path.join(state_dir(), "plugin-install.json")


def journal_path():
    return os.path.join(state_dir(), "plugin-session.json")


def write_atomic(path, text, mode=0o600):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---- trusted filesystem policy
# Directory ancestry is walked from "/" with descriptors opened O_DIRECTORY|O_NOFOLLOW, so a later path substitution
# cannot redirect an action. Ancestors must belong to root or the effective user and must not be writable by other
# accounts (a root-owned sticky directory such as /tmp is the one exception). Dedicated directories, from `own_from`
# downwards, must belong to the effective user.

MAX_STATE_BYTES = 1 << 20
BACKUP_RE = re.compile(r"^backup-\d{8}-\d{6}(?:-(?:[2-9]|[1-9][0-9]+))?$")
SHA_RE = re.compile(r"^(?:[0-9a-f]{64})?$")
SCRIPT_NAMES = ("google-setup.py", "waybar-pill-plugin", "waybar-plugin-widgets", "waybar-volume-osd.py",
                "waybar-brightness-key", "waybar-popupctl", "waybar-app.sh", "waybar-bgapp.sh", "media-follow.py",
                "media-eq.py", "media-art.py")
WHATSAPP_PLUGIN = "io.github.ricky.whatsapp"
WHATSAPP_FILES = ("Panel.qml", "BarWidget.qml", "WaybarPillAnchor.qml")
JOURNAL_PHASES = ("preparing", "active", "restoring")


def config_home():
    base = os.environ.get("XDG_CONFIG_HOME", "")
    return os.path.normpath(base) if base and os.path.isabs(base) else os.path.join(home(), ".config")


def adapter_paths():
    root = os.path.join(config_home(), "omarchy", "plugins", WHATSAPP_PLUGIN)
    return frozenset(os.path.join(root, name) for name in WHATSAPP_FILES)


def plugin_enabled(checkout):
    """Only a trusted enabled manifest entry and an existing checkout allow retaining inert adapter sources."""
    if not checkout:
        return False
    try:
        manifest = json.loads(read_checkout_file(checkout, "manifest.json"))
        if not isinstance(manifest, dict) or manifest.get("id") != PLUGIN_ID:
            return False
        cfg = trusted_state_json(os.path.join(config_home(), "omarchy", "shell.json"))
        if not isinstance(cfg, dict) or not isinstance(cfg.get("plugins"), list):
            return False
        return any(isinstance(p, dict) and p.get("id") == PLUGIN_ID for p in cfg["plugins"])
    except (PluginError, OSError, ValueError):
        return False


def installation_paths():
    """Exact set of absolute destinations install.sh may write; nothing else is ever restored or deleted."""
    h = home()
    if not h or not os.path.isabs(h) or os.path.normpath(h) != h:
        raise PluginError("HOME is not an absolute normalized path")
    w = os.path.join(h, ".config", "waybar")
    paths = {os.path.join(h, ".local", "bin", "waybar-notch"),
             os.path.join(w, "config.jsonc"), os.path.join(w, "style.css"), os.path.join(w, "pill-theme.css"),
             os.path.join(h, ".config", "omarchy", "hooks", "theme-set.d", "50-waybar-pill-bar"),
             os.path.join(h, ".config", "omarchy", "hooks", "font-set.d", "50-waybar-pill-bar"),
             os.path.join(h, ".local", "share", "waybar-notch", "setup", "waybar-setup.py"),
             os.path.join(h, ".local", "share", "waybar-notch", "setup", "apps-catalog.json"),
             os.path.join(h, ".config", "hypr", "autostart.lua"), os.path.join(h, ".config", "hypr", "bindings.lua")}
    paths.update(os.path.join(w, "scripts", n) for n in SCRIPT_NAMES)
    plugin = os.path.join(config_home(), "omarchy", "plugins", WHATSAPP_PLUGIN)
    paths.update(os.path.join(plugin, n) for n in WHATSAPP_FILES)
    return frozenset(paths)


def trust_root(path, default=None):
    """The directory from which `path`'s ancestry must belong to the effective user."""
    for root in (home(), config_home()):
        if path == root or path.startswith(root.rstrip("/") + "/"):
            return root
    return default if default is not None else os.path.dirname(path)


_DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC


def _verify_dir(fd, path, owned):
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode):
        raise PluginError("%s is not a directory" % path)
    mode = stat.S_IMODE(st.st_mode)
    if owned:
        if st.st_uid != os.geteuid():
            raise PluginError("%s is not owned by you" % path)
        if mode & 0o022:
            raise PluginError("%s is writable by other accounts" % path)
    else:
        if st.st_uid not in (0, os.geteuid()):
            raise PluginError("%s belongs to another account" % path)
        if mode & 0o022 and not (st.st_uid == 0 and mode & stat.S_ISVTX):
            raise PluginError("%s is writable by other accounts" % path)
    return st


def open_directory_chain(path, own_from=None, create=False, create_mode=0o700):
    """Descriptor of the directory `path` after validating every ancestor, or None when some component is missing
    (and `create` is false). The caller closes the descriptor. Raises PluginError for links or untrusted owners."""
    if not isinstance(path, str) or not os.path.isabs(path) or os.path.normpath(path) != path or "\0" in path:
        raise PluginError("%s is not an absolute normalized path" % path)
    fd = os.open("/", _DIR_FLAGS)
    cur = ""
    try:
        _verify_dir(fd, "/", False)
        for comp in [c for c in path.split("/") if c]:
            cur += "/" + comp
            try:
                try:
                    nfd = os.open(comp, _DIR_FLAGS, dir_fd=fd)
                except FileNotFoundError:
                    if not create:
                        return None
                    try:
                        os.mkdir(comp, create_mode, dir_fd=fd)
                    except FileExistsError:
                        pass
                    nfd = os.open(comp, _DIR_FLAGS, dir_fd=fd)
            except OSError as e:
                raise PluginError("%s is not a trusted directory (%s)" % (cur, e.strerror or type(e).__name__))
            os.close(fd)
            fd = nfd
            owned = own_from is not None and (cur == own_from or cur.startswith(own_from.rstrip("/") + "/"))
            _verify_dir(fd, cur, owned)
        result, fd = fd, None
        return result
    finally:
        if fd is not None:
            os.close(fd)


def validate_directory_chain(path, own_from=None):
    """True when the directory exists with a trusted ancestry, False when its tail is missing; PluginError otherwise."""
    fd = open_directory_chain(path, own_from)
    if fd is None:
        return False
    os.close(fd)
    return True


def check_leaf(st, path, state=False):
    if not stat.S_ISREG(st.st_mode):
        raise PluginError("%s is not a regular file" % path)
    if st.st_uid != os.geteuid():
        raise PluginError("%s is not owned by you" % path)
    if state and (st.st_nlink != 1 or stat.S_IMODE(st.st_mode) & 0o022):
        raise PluginError("%s has unsafe links or permissions" % path)


def open_leaf(dfd, name, path, state=False):
    """Read-only descriptor of an owned regular file inside `dfd`; never follows a link or blocks on a FIFO."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
    except FileNotFoundError:
        raise
    except OSError as e:
        raise PluginError("%s cannot be opened safely (%s)" % (path, e.strerror or type(e).__name__))
    try:
        check_leaf(os.fstat(fd), path, state)
    except BaseException:
        os.close(fd)
        raise
    return fd


def leaf_present(path, own_from=None):
    """Whether an owned regular file exists at `path` (False when absent); an unsafe leaf or parent is an error."""
    dfd = open_directory_chain(os.path.dirname(path), own_from if own_from is not None else trust_root(path))
    if dfd is None:
        return False
    try:
        try:
            st = os.stat(os.path.basename(path), dir_fd=dfd, follow_symlinks=False)
        except FileNotFoundError:
            return False
        check_leaf(st, path)
        return True
    finally:
        os.close(dfd)


def _no_duplicates(pairs):
    out = {}
    for k, v in pairs:
        if k in out:
            raise ValueError("duplicate key")
        out[k] = v
    return out


def _no_constant(_):
    raise ValueError("non-finite number")


def trusted_state_json(path):
    """Decoded JSON of a record in a dedicated state directory, or None when it does not exist. Never creates or
    tightens anything, and never echoes file content."""
    d, name = os.path.split(path)
    dfd = open_directory_chain(d, own_from=d)
    if dfd is None:
        return None
    try:
        try:
            fd = open_leaf(dfd, name, path, state=True)
        except FileNotFoundError:
            return None
        with os.fdopen(fd, "rb") as f:
            data = f.read(MAX_STATE_BYTES + 1)
    finally:
        os.close(dfd)
    if len(data) > MAX_STATE_BYTES:
        raise PluginError("%s is too large" % path)
    try:
        return json.loads(data.decode("utf-8"), object_pairs_hook=_no_duplicates, parse_constant=_no_constant)
    except ValueError:
        raise PluginError("%s is malformed" % path)


def write_state_json(path, value):
    """Atomically publish a record as 0600 in its dedicated state directory (created 0700; an owned looser one is
    tightened). Callers validate the record first."""
    data = (json.dumps(value, indent=2) + "\n").encode()
    if len(data) > MAX_STATE_BYTES:
        raise PluginError("%s would be too large" % path)
    d, name = os.path.split(path)
    dfd = open_directory_chain(d, own_from=d, create=True)
    tmp = ".tmp.%s" % secrets.token_hex(8)
    try:
        os.fchmod(dfd, 0o700)
        try:
            check_leaf(os.stat(name, dir_fd=dfd, follow_symlinks=False), path, state=True)
        except FileNotFoundError:
            pass
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dfd)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=dfd)
            except OSError:
                pass
            raise
    finally:
        os.close(dfd)


def remove_state(path):
    d, name = os.path.split(path)
    dfd = open_directory_chain(d, own_from=d)
    if dfd is None:
        return
    try:
        try:
            os.unlink(name, dir_fd=dfd)
        except FileNotFoundError:
            pass
    finally:
        os.close(dfd)


def validate_record(m):
    """Schema and footprint-allowlist validation of the install record; raises PluginError, never echoes content."""
    where = marker_path()
    if not isinstance(m, dict) or type(m.get("version")) is not int or m["version"] != 1 or m.get("mode") != "plugin":
        raise PluginError("%s is malformed or from an unsupported version" % where)
    backup, files = m.get("backup_dir"), m.get("files")
    if not isinstance(backup, str) or not isinstance(files, list):
        raise PluginError("%s is malformed" % where)
    if os.path.dirname(backup) != os.path.join(home(), ".config", "waybar") or not BACKUP_RE.match(os.path.basename(backup)):
        raise PluginError("%s names a backup directory outside the installation footprint" % where)
    allowed = installation_paths()
    seen = set()
    for e in files:
        if not isinstance(e, dict) or not {"path", "existed", "installed_sha256"} <= set(e) <= {"path", "existed", "installed_sha256", "retained_sha256"}:
            raise PluginError("%s has a malformed file entry" % where)
        p, existed, sha = e["path"], e["existed"], e["installed_sha256"]
        if not isinstance(p, str) or not os.path.isabs(p) or os.path.normpath(p) != p:
            raise PluginError("%s has a malformed file path" % where)
        if p not in allowed:
            raise PluginError("%s lists a path outside the installation footprint" % where)
        if p in seen:
            raise PluginError("%s lists a path twice" % where)
        seen.add(p)
        if type(existed) is not bool or not isinstance(sha, str) or not SHA_RE.match(sha) \
                or ("retained_sha256" in e and not (isinstance(e["retained_sha256"], str) and SHA_RE.match(e["retained_sha256"]))):
            raise PluginError("%s has a malformed file entry" % where)
    return m


def read_marker():
    """None when the plugin was never set up; an untrusted or malformed marker is an error, never a fallback."""
    m = trusted_state_json(marker_path())
    if m is None:
        return None
    return validate_record(m)


def validate_journal(j):
    if not isinstance(j, dict) or type(j.get("version")) is not int or j["version"] != 1:
        raise PluginError("recovery journal is malformed or from an unsupported version")
    added = j.get("disabled_plugins_added")
    if j.get("phase") not in JOURNAL_PHASES or type(j.get("bar_hidden_before")) is not bool \
            or type(j.get("waybar_was_active")) is not bool or not isinstance(added, list) \
            or not all(isinstance(i, str) for i in added) or len(set(added)) != len(added):
        raise PluginError("recovery journal is malformed")
    return j


def mode():
    """Installation diagnostic: 'plugin' for a valid install record, an error otherwise."""
    if read_marker() is None:
        raise PluginError("the plugin is not provisioned: setup runs when waybar.pill-bar is enabled")
    return "plugin"


def sha256_of(path):
    """SHA-256 of an owned regular file reached without following any link."""
    dfd = open_directory_chain(os.path.dirname(path), trust_root(path))
    if dfd is None:
        raise FileNotFoundError(path)
    try:
        fd = open_leaf(dfd, os.path.basename(path), path)
    finally:
        os.close(dfd)
    h = hashlib.sha256()
    with os.fdopen(fd, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def record_generated_files(paths):
    """Bless product-regenerated outputs. Only paths already in the install record are accepted."""
    m = read_marker()
    if m is None:
        raise PluginError("the plugin is not provisioned")
    entries = {e["path"]: e for e in m["files"]}
    real = [os.path.abspath(p) for p in paths]
    for p in real:
        if p not in entries:
            raise PluginError("%s is not part of the plugin install record" % p)
    for p in real:
        entries[p]["installed_sha256"] = sha256_of(p)
        refresh_after_image(m, p)
    write_state_json(marker_path(), m)


def refresh_after_image(m, path):
    """Keep a blessed regeneration of `path` as its after-image, so restoring a Lua file still recognizes the product
    block it wrote. Records from before after-images existed carry none; nothing is created for them."""
    dst = os.path.join(m["backup_dir"], ".installed") + path
    ddfd = open_directory_chain(os.path.dirname(dst), own_from=home())
    if ddfd is None:
        return
    try:
        try:
            check_leaf(os.stat(os.path.basename(dst), dir_fd=ddfd, follow_symlinks=False), dst)
        except FileNotFoundError:
            return
        sdfd = open_directory_chain(os.path.dirname(path), own_from=trust_root(path))
        if sdfd is None:
            raise FileNotFoundError(path)
        try:
            sfd = open_leaf(sdfd, os.path.basename(path), path)
        finally:
            os.close(sdfd)
        with os.fdopen(sfd, "rb") as f:
            data = f.read(MAX_STATE_BYTES * 8 + 1)
            mode = stat.S_IMODE(os.fstat(f.fileno()).st_mode)
        if len(data) > MAX_STATE_BYTES * 8:
            raise PluginError("%s is too large" % path)
        tmp = ".tmp.%s" % secrets.token_hex(8)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=ddfd)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
                os.fchmod(f.fileno(), mode)
            os.replace(tmp, os.path.basename(dst), src_dir_fd=ddfd, dst_dir_fd=ddfd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=ddfd)
            except OSError:
                pass
            raise
    finally:
        os.close(ddfd)


def runtime_dir(create=True):
    root = os.environ.get("XDG_RUNTIME_DIR", "")
    if not root or not os.path.isabs(root):
        raise PluginError("XDG_RUNTIME_DIR is not set to an absolute path")
    st = os.lstat(root) if os.path.lexists(root) else None
    if st is None or not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or stat.S_IMODE(st.st_mode) & 0o077:
        raise PluginError("XDG_RUNTIME_DIR is not a private directory owned by you")
    d = os.path.join(root, "waybar-pill-plugin")
    if not os.path.lexists(d):
        if not create:
            return d
        os.mkdir(d, 0o700)
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or stat.S_IMODE(st.st_mode) & 0o077:
        raise PluginError("%s is a symlink, not yours, or not mode 0700" % d)
    return d


def sock_path():
    return os.path.join(runtime_dir(), "control.sock")


def request(op, timeout=5.0):
    """Send one short-lived control request; returns the decoded reply or None if no backend is listening."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(sock_path())
    except (FileNotFoundError, ConnectionRefusedError, socket.timeout):
        s.close()
        return None
    with s:
        try:
            s.sendall((json.dumps({"op": op}) + "\n").encode())
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = s.recv(4096)
                if not chunk:
                    return None
                buf += chunk
        except (ConnectionResetError, BrokenPipeError, socket.timeout):
            return None  # the backend closed the socket (or stopped answering) while shutting down: no session to talk to
    try:
        return json.loads(buf.decode())
    except ValueError:
        raise PluginError("backend sent an invalid reply")


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


class Session:
    """One lease's worth of ownership. `runner` is the only way it touches the desktop, so tests can observe it."""

    def __init__(self, runner=run, popen=subprocess.Popen, state=None, checkout=None):
        self.runner = runner
        self.popen = popen
        self.state = state  # the in-memory durable state helper that restores the managed files; None: no files
        self.checkout = checkout  # None (explicit recover): adapters are never retained
        self.idle = None  # callable(timeout) that services the control socket while this session waits
        self.before_restore = None  # callable run right before the files are restored (closes the control listener)
        self.children = []  # [(name, Popen)] in start order
        self.active = False
        self.cleaned = False
        self.sockets = []  # absolute paths of the session-owned sockets (notch listeners)

    # ---- external queries
    def sh(self, *cmd):
        return self.runner(list(cmd))

    def notify_owner_pid(self):
        r = self.sh("busctl", "--user", "status", NOTIFY_NAME)
        if r.returncode != 0:
            return None
        for ln in r.stdout.splitlines():
            if ln.startswith("PID="):
                return int(ln[4:])
        return None

    def plugin_list(self):
        r = self.sh("omarchy", "plugin", "list", "--json")
        if r.returncode != 0:
            raise PluginError("omarchy plugin list failed: " + r.stderr.strip())
        return json.loads(r.stdout)

    def conflicting_enabled(self):
        out = []
        for p in self.plugin_list():
            if p.get("enabled") and (p["id"] in CONFLICTS or p.get("clonedFrom") in CONFLICTS):
                out.append(p["id"])
        return out

    def shell_json(self):
        return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(home(), ".config"), "omarchy", "shell.json")

    def bar_flag(self):
        return os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(home(), ".local", "state"), "omarchy", "toggles", "bar-off")

    def load_shell(self):
        try:
            with open(self.shell_json()) as f:
                cfg = json.load(f)
        except (OSError, ValueError) as e:
            raise PluginError("cannot use %s: %s" % (self.shell_json(), e))
        if not isinstance(cfg, dict) or not isinstance(cfg.get("disabledPlugins", []), list):
            raise PluginError("%s has an unsupported shape" % self.shell_json())
        return cfg

    def edit_disabled(self, add=(), remove=()):
        cfg = self.load_shell()
        cur = list(cfg.get("disabledPlugins", []))
        new = [i for i in cur if i not in remove] + [i for i in add if i not in cur]
        if new == cur:
            return
        cfg["disabledPlugins"] = new
        try:
            mode = stat.S_IMODE(os.stat(self.shell_json()).st_mode)
        except OSError as e:
            raise PluginError("cannot inspect %s: %s" % (self.shell_json(), e))
        write_atomic(self.shell_json(), json.dumps(cfg, indent=2) + "\n", mode)
        self.sh("omarchy-shell", "shell", "reloadConfig")

    def ensure_notifications(self):
        """Never leave the desktop without a notification daemon/OSD after restore."""
        cfg = self.load_shell()
        dis = list(cfg.get("disabledPlugins", []))
        plugins = cfg.get("plugins", {})
        names = [n.get("id", "") if isinstance(n, dict) else str(n) for n in (plugins if isinstance(plugins, list) else [])]
        active = [n for n in names if "notifications" in str(n) and n not in dis]
        if "omarchy.notifications" in dis and not active:
            self.edit_disabled(remove=["omarchy.notifications", "omarchy.osd"])

    # ---- journal
    def save_journal(self, j):
        write_state_json(journal_path(), validate_journal(j))

    # ---- transaction
    def preflight(self):
        if read_marker() is None:
            raise PluginError("the plugin is not provisioned: setup runs when waybar.pill-bar is enabled")
        b = os.path.join(home(), ".local", "bin", "waybar-notch")
        helper = os.path.join(home(), ".config", "waybar", "scripts", "waybar-popupctl")
        for p in (b, helper):
            if not os.path.exists(p):
                raise PluginError("%s is missing: provisioning did not install it" % p)
        drop = os.path.join(home(), ".config", "systemd", "user", "waybar.service.d", "50-waybar-notch.conf")
        if os.path.exists(drop) or self.sh("systemctl", "--user", "is-enabled", "waybar-notch.service").returncode == 0:
            raise PluginError("Legacy standalone files detected; remove the old standalone installation with its original uninstaller, then enable the plugin again.")
        self.load_shell()
        if self.sh("omarchy", "plugin", "list", "--json").returncode != 0:
            raise PluginError("Omarchy plugin IPC is not working")

    def waybar_unit_was_active(self):
        if self.sh("systemctl", "--user", "is-active", "--quiet", "waybar.service").returncode != 0:
            return False
        r = self.sh("systemctl", "--user", "show", "waybar.service", "-p", "ExecStart", "--value")
        if "waybar-notch" in r.stdout or "path=" not in r.stdout or "/waybar " not in r.stdout.replace(" ;", " "):
            raise PluginError("waybar.service is not a plain Waybar; refusing to stop it")
        return True

    def native_targets_gone(self):
        """The native QML handlers answer `ping` until unloaded; the process-wide bus name is not released with them."""
        return all(self.sh("omarchy-shell", t, "ping").returncode != 0 for t in ("notifications", "osd"))

    def prepare_session_socket(self, name):
        """Path of one of this session's own sockets, after clearing a stale one left by a dead session."""
        if name not in SESSION_SOCKETS:
            raise PluginError("%s is not a session socket" % name)
        path = os.path.join(runtime_dir(), name)
        try:
            st = os.lstat(path)
        except FileNotFoundError:
            return path
        if not stat.S_ISSOCK(st.st_mode) or st.st_uid != os.getuid():
            raise PluginError("%s is not a socket of yours; remove it and retry" % path)
        os.unlink(path)  # the runtime flock proves no live session owns it
        return path

    def activate(self, shell_pid, connect_relay):
        """`shell_pid` is the lease peer (the Quickshell process). `connect_relay` runs the QML handshake and raises
        PluginError unless the shell attached its notification server to the notch."""
        self.preflight()
        owner = self.notify_owner_pid()
        if owner is not None and owner != shell_pid:
            raise PluginError("another process (pid %d) owns %s; it was not touched" % (owner, NOTIFY_NAME))
        waybar_was_active = self.waybar_unit_was_active()
        conflicts = self.conflicting_enabled()
        journal = {"version": 1, "phase": "preparing", "bar_hidden_before": os.path.exists(self.bar_flag()),
                   "disabled_plugins_added": conflicts, "waybar_was_active": waybar_was_active}
        self.save_journal(journal)
        try:
            self.edit_disabled(add=conflicts)
            self.wait_until(lambda: not self.conflicting_enabled() and self.native_targets_gone(), 5.0,
                            "native notifications/OSD did not unload")
            self.sockets = [self.prepare_session_socket(n) for n in SESSION_SOCKETS]
            if not journal["bar_hidden_before"]:
                self.sh("omarchy", "toggle", "bar", "on")
            if waybar_was_active:
                self.sh("systemctl", "--user", "stop", "waybar.service")
            baseline = set(self.hypr_errors())
            exe = os.path.join(home(), ".local", "bin", "waybar-notch")
            env = {k: v for k, v in os.environ.items() if k not in ("GDK_SCALE", "GDK_DPI_SCALE")}
            for name, args in (("notch", [exe, "--notification-relay", str(shell_pid)]),):
                self.children.append((name, self.popen(args, env=env, start_new_session=True,
                                                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)))
            self.wait_until(lambda: self.ready(baseline), READY_WAIT, "the notch and pills did not become ready")
            connect_relay()
            self.check_children()
            owner = self.notify_owner_pid()
            if owner != shell_pid:
                raise PluginError("the shell does not own %s after attaching the relay" % NOTIFY_NAME)
            journal["phase"] = "active"
            self.save_journal(journal)
            self.active = True
        except BaseException:
            self.cleanup()
            raise

    def hypr_errors(self):
        r = self.sh("hyprctl", "configerrors")
        return [ln for ln in (r.stdout + r.stderr).splitlines() if ln.strip()]

    def wait_until(self, pred, limit, msg):
        end = time.monotonic() + limit
        while True:
            self.check_children()
            if pred():
                return
            if time.monotonic() > end:
                raise PluginError(msg)
            if self.idle is not None:
                self.idle(0.1)
            else:
                time.sleep(0.1)

    def check_children(self):
        for name, p in self.children:
            if p.poll() is not None:
                raise PluginError("%s exited (status %s) during the session" % (name, p.returncode))

    def ready(self, baseline):
        rt = os.environ["XDG_RUNTIME_DIR"]
        try:
            if not stat.S_ISFIFO(os.stat(os.path.join(rt, "waybar-popupd.fifo")).st_mode):
                return False
        except OSError:
            return False
        for path in self.sockets:
            try:
                if not stat.S_ISSOCK(os.lstat(path).st_mode):
                    return False
            except OSError:
                return False
        r = self.sh("hyprctl", "layers", "-j")
        if '"waybar-notch"' not in r.stdout.replace(" ", ""):
            return False
        fresh = [e for e in self.hypr_errors() if e not in baseline]
        if fresh:
            raise PluginError("Hyprland reported new config errors: " + "; ".join(fresh))
        return True

    def signal_notch(self, sig):
        """SIGUSR1 toggles the bar's visibility, SIGUSR2 reloads theme/settings."""
        for name, p in self.children:
            if name == "notch" and p.poll() is None:
                os.kill(p.pid, sig)
                return True
        return False

    def cleanup(self):
        """Idempotent. Stops only recorded child groups, then restores only what this session changed."""
        if self.cleaned:
            return
        self.cleaned = True
        self.active = False
        for _, p in self.children:
            terminate_group(p)
        self.children = []
        for path in self.sockets:
            try:
                if stat.S_ISSOCK(os.lstat(path).st_mode):
                    os.unlink(path)
            except OSError:
                pass
        self.sockets = []
        if self.before_restore is not None:
            self.before_restore()
        restore_everything(self)

    def reap(self, p, limit):
        try:
            p.wait(limit)
        except subprocess.TimeoutExpired:
            pass

    def restore_files(self):
        """Put the managed files back through the in-memory state helper, then reload Hyprland. True when nothing is
        left to restore."""
        if self.state is None:
            return True
        try:
            if read_marker() is None:
                return True
            if plugin_enabled(self.checkout):
                rc = self.state.uninstall(False, retain_adapter=True)
            else:
                rc = self.state.uninstall(False)
        except (PluginError, OSError) as e:
            print("waybar-pill-plugin: cannot restore the managed files: %s" % e, file=sys.stderr)
            return False
        if rc != 0:
            return False
        try:
            self.sh("hyprctl", "reload")
            errors = self.hypr_errors()
        except OSError:
            return True
        if errors:
            print("waybar-pill-plugin: Hyprland reports config errors after restoring the files: " + "; ".join(errors), file=sys.stderr)
        return True


def recover_hint():
    return "python3 %s recover" % os.path.abspath(__file__)


def restore_everything(session):
    """Files first (so a native Waybar never restarts against managed ones), then the journaled native desktop. True
    when both are complete."""
    journal = trusted_state_json(journal_path())
    if journal is not None:
        validate_journal(journal)
    files_ok = session.restore_files()
    desktop_ok = restore(session)
    if not files_ok:
        print("waybar-pill-plugin: the managed files could not be restored; resolve the conflicts listed above, then run: %s"
              % recover_hint(), file=sys.stderr)
    return files_ok and desktop_ok


def restore(session=None):
    """Undo a journaled session. The journal is kept if anything could not be restored. True when nothing is left."""
    s = session or Session()
    j = trusted_state_json(journal_path())
    if j is None:
        return True
    validate_journal(j)
    j["phase"] = "restoring"
    s.save_journal(j)
    failed = []
    try:
        s.edit_disabled(remove=j.get("disabled_plugins_added", []))
        s.ensure_notifications()
    except Exception as e:
        failed.append("plugins: %s" % e)
    try:
        if not j.get("bar_hidden_before") and os.path.exists(s.bar_flag()):
            r = s.sh("omarchy", "toggle", "bar", "off")
            if r.returncode != 0:
                failed.append("bar: " + r.stderr.strip())
        if j.get("waybar_was_active"):
            r = s.sh("systemctl", "--user", "start", "waybar.service")
            if r.returncode != 0:
                failed.append("native Waybar: " + r.stderr.strip())
    except Exception as e:
        failed.append("native bar: %s" % e)
    if failed:
        print("waybar-pill-plugin: restoration incomplete (%s); run: %s" % ("; ".join(failed), recover_hint()), file=sys.stderr)
        return False
    remove_state(journal_path())
    return True


# ---- plugin checkout and durable lifecycle generations

MAX_SOURCE_BYTES = 4 << 20
LOG_LIMIT = 1 << 20
CHECKOUT_FILES = ("install.sh", "files/scripts/waybar-pill-plugin", "files/setup/plugin-state.py")
# (directory, file name, checkout path, mode) of an immutable lifecycle generation. The layout mirrors the checkout's
# files/{scripts,setup}, so the state helper finds the bridge the same way in both places.
GENERATION_FILES = (("scripts", "waybar-pill-plugin", "files/scripts/waybar-pill-plugin", 0o500),
                    ("setup", "plugin-state.py", "files/setup/plugin-state.py", 0o400))


def data_dir():
    base = os.environ.get("XDG_DATA_HOME", "")
    base = os.path.normpath(base) if base and os.path.isabs(base) else os.path.join(home(), ".local", "share")
    return os.path.join(base, "waybar-notch")


def lifecycle_dir():
    return os.path.join(data_dir(), "lifecycle")


def provision_log_path():
    return os.path.join(state_dir(), "provision.log")


def read_checkout_file(checkout, rel):
    """Bytes of an owned regular file below the checkout, reached through directory descriptors that never follow a link."""
    parts = rel.split("/")
    dpath = os.path.join(checkout, *parts[:-1]) if len(parts) > 1 else checkout
    dfd = open_directory_chain(dpath, own_from=trust_root(checkout))
    if dfd is None:
        raise PluginError("%s is missing from the plugin checkout %s" % (rel, checkout))
    try:
        try:
            fd = open_leaf(dfd, parts[-1], os.path.join(checkout, rel), state=True)
        except FileNotFoundError:
            raise PluginError("%s is missing from the plugin checkout %s" % (rel, checkout))
    finally:
        os.close(dfd)
    with os.fdopen(fd, "rb") as f:
        data = f.read(MAX_SOURCE_BYTES + 1)
    if len(data) > MAX_SOURCE_BYTES:
        raise PluginError("%s is too large" % rel)
    return data


def validate_checkout(checkout):
    """{checkout path: bytes} of the lifecycle sources of a checkout that really is this plugin: an absolute normalized
    path, a manifest whose id is waybar.pill-bar, and owned regular files (never links) for every source."""
    if not isinstance(checkout, str) or not os.path.isabs(checkout) or os.path.normpath(checkout) != checkout or "\0" in checkout:
        raise PluginError("%s is not an absolute normalized checkout path" % checkout)
    try:
        manifest = json.loads(read_checkout_file(checkout, "manifest.json").decode("utf-8"),
                              object_pairs_hook=_no_duplicates, parse_constant=_no_constant)
    except (ValueError, UnicodeDecodeError):
        raise PluginError("%s/manifest.json is malformed" % checkout)
    if not isinstance(manifest, dict) or manifest.get("id") != PLUGIN_ID:
        raise PluginError("%s is not the %s plugin" % (checkout, PLUGIN_ID))
    for rel in ("files/scripts", "files/setup", "files/hooks", "files/hypr", "files/qml", "notch/src"):
        path = os.path.join(checkout, rel)
        parent = open_directory_chain(os.path.dirname(path), own_from=trust_root(checkout))
        if parent is None:
            continue
        try:
            try:
                validate_tree(parent, os.path.basename(path), path)
            except FileNotFoundError:
                pass  # minimal test checkouts need only their install script and lifecycle helpers
        finally:
            os.close(parent)
    return {rel: read_checkout_file(checkout, rel) for rel in CHECKOUT_FILES}


def _generation_matches(rfd, gen, files):
    """True when GENERATION exists with exactly these bytes, False when it does not exist; anything else is an error."""
    try:
        gfd = os.open(gen, _DIR_FLAGS, dir_fd=rfd)
    except FileNotFoundError:
        return False
    except OSError as e:
        raise PluginError("lifecycle generation %s is not trusted (%s)" % (gen, e.strerror or type(e).__name__))
    try:
        _verify_dir(gfd, gen, True)
        if stat.S_IMODE(os.fstat(gfd).st_mode) != 0o700 or set(os.listdir(gfd)) != {"scripts", "setup"}:
            raise PluginError("lifecycle generation %s has unsafe contents or permissions" % gen)
        for sub, name, rel, _ in GENERATION_FILES:
            where = "%s/%s/%s" % (gen, sub, name)
            try:
                sfd = os.open(sub, _DIR_FLAGS, dir_fd=gfd)
            except OSError:
                raise PluginError("lifecycle generation %s is incomplete" % gen)
            try:
                _verify_dir(sfd, where, True)
                if stat.S_IMODE(os.fstat(sfd).st_mode) != 0o700 or os.listdir(sfd) != [name]:
                    raise PluginError("lifecycle generation %s has unsafe contents or permissions" % gen)
                try:
                    fd = open_leaf(sfd, name, where)
                except FileNotFoundError:
                    raise PluginError("lifecycle generation %s is incomplete" % gen)
                with os.fdopen(fd, "rb") as f:
                    data = f.read(MAX_SOURCE_BYTES + 1)
            finally:
                os.close(sfd)
            if data != files[rel]:
                raise PluginError("lifecycle generation %s was modified; remove it and retry" % gen)
    finally:
        os.close(gfd)
    return True


def _write_generation(rfd, tmp, files):
    os.mkdir(tmp, 0o700, dir_fd=rfd)
    tfd = os.open(tmp, _DIR_FLAGS, dir_fd=rfd)
    try:
        for sub, name, rel, mode in GENERATION_FILES:
            os.mkdir(sub, 0o700, dir_fd=tfd)
            sfd = os.open(sub, _DIR_FLAGS, dir_fd=tfd)
            try:
                fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=sfd)
                with os.fdopen(fd, "wb") as f:
                    f.write(files[rel])
                    f.flush()
                    os.fsync(f.fileno())
                    os.fchmod(f.fileno(), mode)
                os.fsync(sfd)
            finally:
                os.close(sfd)
        os.fsync(tfd)
    finally:
        os.close(tfd)


def stage_generation(files):
    """Path of the immutable lifecycle generation that holds exactly these helper bytes. It is published by one atomic
    rename of a fully written private directory and verified (never rewritten) when it already exists."""
    h = hashlib.sha256()
    for _, name, rel, _ in GENERATION_FILES:
        h.update(name.encode() + b"\0" + len(files[rel]).to_bytes(8, "big") + files[rel])
    gen = h.hexdigest()[:32]
    root = lifecycle_dir()
    rfd = open_directory_chain(root, own_from=data_dir(), create=True)
    try:
        if _generation_matches(rfd, gen, files):
            return os.path.join(root, gen)
        tmp = ".stage.%s" % secrets.token_hex(8)
        try:
            _write_generation(rfd, tmp, files)
            try:
                os.rename(tmp, gen, src_dir_fd=rfd, dst_dir_fd=rfd)
                os.fsync(rfd)
            except OSError as e:
                if e.errno not in (errno.EEXIST, errno.ENOTEMPTY):
                    raise
                if not _generation_matches(rfd, gen, files):  # another launcher published it first
                    raise PluginError("lifecycle generation %s exists with other content" % gen)
        finally:
            try:
                remove_tree(rfd, tmp, tmp)
            except OSError:
                pass  # renamed away (the normal case) or never created
    finally:
        os.close(rfd)
    return os.path.join(root, gen)


def validate_tree(parent_fd, name, label, depth=0, counter=None):
    """Read-only walk of a product-owned directory through descriptors: only owned regular files and directories."""
    counter = counter if counter is not None else [0]
    if depth > MAX_TREE_DEPTH:
        raise PluginError("%s is nested too deeply" % label)
    fd = os.open(name, _DIR_FLAGS, dir_fd=parent_fd)
    try:
        _verify_dir(fd, label, True)
        for entry in os.listdir(fd):
            counter[0] += 1
            if counter[0] > MAX_TREE_ENTRIES:
                raise PluginError("%s holds too many entries" % label)
            st = os.stat(entry, dir_fd=fd, follow_symlinks=False)
            sub = label + "/" + entry
            if stat.S_ISDIR(st.st_mode):
                validate_tree(fd, entry, sub, depth + 1, counter)
            else:
                check_leaf(st, sub, state=True)
    finally:
        os.close(fd)


def remove_tree(parent_fd, name, label, depth=0):
    """Delete a product-owned directory tree through descriptors. Links, special files and foreign owners are never
    followed or removed: they stop the removal with PluginError."""
    if depth > MAX_TREE_DEPTH:
        raise PluginError("%s is nested too deeply" % label)
    fd = os.open(name, _DIR_FLAGS, dir_fd=parent_fd)
    try:
        if os.fstat(fd).st_uid != os.geteuid():
            raise PluginError("%s is not owned by you" % label)
        os.fchmod(fd, 0o700)
        for entry in os.listdir(fd):
            st = os.stat(entry, dir_fd=fd, follow_symlinks=False)
            sub = label + "/" + entry
            if stat.S_ISDIR(st.st_mode):
                remove_tree(fd, entry, sub, depth + 1)
            elif stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid():
                os.unlink(entry, dir_fd=fd)
            else:
                raise PluginError("%s is not an owned regular file or directory" % sub)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


def purge_tree(parent_fd, name, label, depth=0):
    """Descriptor-relative removal of a profile directory: subdirectories are entered only as owned real directories;
    links, sockets and files are unlinked themselves, never opened or followed."""
    if depth > MAX_TREE_DEPTH:
        raise PluginError("%s is nested too deeply" % label)
    fd = os.open(name, _DIR_FLAGS, dir_fd=parent_fd)
    try:
        if os.fstat(fd).st_uid != os.geteuid():
            raise PluginError("%s is not owned by you" % label)
        os.fchmod(fd, 0o700)
        for entry in os.listdir(fd):
            st = os.stat(entry, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISDIR(st.st_mode):
                purge_tree(fd, entry, label + "/" + entry, depth + 1)
            else:
                os.unlink(entry, dir_fd=fd)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


PURGE_TARGETS = (
    (".config", "waybar-notch", "google.json"),
    (".config", "waybar-notch", "project-id"),
    (".local", "share", "waybar-notch", "google-token.json"),
    (".local", "share", "waybar-notch", "browser-profile"),
)


def purge_credentials(check_only=False):
    """Remove the product's Google credential footprint (the four fixed HOME-relative names) through descriptors.
    Every parent is validated before anything is removed; links are unlinked, never followed; missing is success."""
    h = home()
    found = []
    try:
        for rel in PURGE_TARGETS:
            parent = os.path.join(h, *rel[:-1])
            dfd = open_directory_chain(parent, own_from=h)
            if dfd is None:
                continue
            try:
                try:
                    st = os.stat(rel[-1], dir_fd=dfd, follow_symlinks=False)
                except FileNotFoundError:
                    continue
                if stat.S_ISDIR(st.st_mode):
                    fd = os.open(rel[-1], _DIR_FLAGS, dir_fd=dfd)
                    try:
                        if os.fstat(fd).st_uid != os.geteuid():
                            raise PluginError("%s is not owned by you" % "/".join(rel))
                    finally:
                        os.close(fd)
                elif not (stat.S_ISLNK(st.st_mode) or (stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid())):
                    raise PluginError("%s is not an owned regular file, directory or link" % "/".join(rel))
                found.append((rel, st))
            finally:
                os.close(dfd)
        if check_only:
            return
        for rel, st in found:
            dfd = open_directory_chain(os.path.join(h, *rel[:-1]), own_from=h)
            if dfd is None:
                continue
            try:
                if stat.S_ISDIR(st.st_mode):
                    try:
                        purge_tree(dfd, rel[-1], "/".join(rel))
                    except FileNotFoundError:
                        pass
                else:
                    try:
                        os.unlink(rel[-1], dir_fd=dfd)
                    except FileNotFoundError:
                        pass
            finally:
                os.close(dfd)
    except OSError as e:
        raise PluginError("cannot remove the credentials: %s" % (e.strerror or type(e).__name__))


def open_provision_log(rotate=False):
    """Append-mode descriptor of the private provisioning log (state directory 0700, log 0600). `rotate` empties a log
    that has grown past 1 MiB."""
    d = state_dir()
    dfd = open_directory_chain(d, own_from=d, create=True)
    try:
        os.fchmod(dfd, 0o700)
        try:
            fd = os.open("provision.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, 0o600, dir_fd=dfd)
        except OSError as e:
            raise PluginError("cannot open the provisioning log: %s" % (e.strerror or type(e).__name__))
    finally:
        os.close(dfd)
    try:
        st = os.fstat(fd)
        check_leaf(st, provision_log_path())
        if st.st_nlink != 1:
            raise PluginError("%s has unsafe links" % provision_log_path())
        os.fchmod(fd, 0o600)
        if rotate and st.st_size > LOG_LIMIT:
            os.ftruncate(fd, 0)
    except BaseException:
        os.close(fd)
        raise
    return fd


def load_state_module():
    """The state helper that sits beside this script (files/setup in a checkout or a lifecycle generation), imported
    into this process so restoring files never depends on the checkout still existing."""
    path = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "setup", "plugin-state.py"))
    if not os.path.isfile(path):
        raise PluginError("the state helper %s is missing; run this from the plugin checkout or a lifecycle generation" % path)
    loader = importlib.machinery.SourceFileLoader("waybar_plugin_state", path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


# ---- server

def lock_runtime():
    d = runtime_dir()
    fd = os.open(os.path.join(d, "lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as e:
        os.close(fd)
        if e.errno in (errno.EAGAIN, errno.EACCES):
            return None
        raise
    return fd


def peer_credentials(conn):
    """(pid, uid, gid) of the process on the other end of a Unix socket, from the kernel."""
    import struct
    cred = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    return struct.unpack("3i", cred)


def relay_handshake(conn, session, limit=READY_WAIT, service=None):
    """Ask the shell's plugin to attach its notification server to the notch, then wait for its acknowledgement.
    `service` (optional) answers control requests between reads."""
    try:
        conn.sendall((json.dumps({"ok": True, "active": False, "stage": "connect-relay"}) + "\n").encode())
    except OSError:
        raise PluginError("the lease closed before the notification relay was ready")
    end = time.monotonic() + limit
    buf = b""
    while b"\n" not in buf:
        session.check_children()
        if service is not None:
            service()
        left = end - time.monotonic()
        if left <= 0:
            raise PluginError("the shell did not attach the notification relay in time")
        if not select.select([conn], [], [], min(0.2, left))[0]:
            continue
        chunk = conn.recv(4096)
        if not chunk:
            raise PluginError("the lease closed before the notification relay was ready")
        buf += chunk
        if len(buf) > 4096:
            raise PluginError("the shell sent an oversized relay acknowledgement")
    try:
        ack = json.loads(buf.split(b"\n")[0].decode())
    except ValueError:
        ack = None
    if ack != {"op": "relay-ready", "version": 1}:
        raise PluginError("the shell sent an invalid relay acknowledgement")


def read_line(conn, limit=5.0):
    conn.settimeout(limit)
    buf = b""
    while b"\n" not in buf and len(buf) < 4096:
        c = conn.recv(256)
        if not c:
            break
        buf += c
    return json.loads(buf.split(b"\n")[0].decode())


def reply(conn, ok, active, error=None):
    r = {"ok": ok, "active": active}
    if error:
        r["error"] = error
    try:
        conn.sendall((json.dumps(r) + "\n").encode())
    except OSError:
        pass


class Cancelled(PluginError):
    """The lease ended or a stop was requested while the session was being established."""


class Control:
    """The control socket and the lease of one backend. `pump` is the only place either is serviced, so every wait
    (provisioning, readiness) keeps answering short probes and notices the lease closing."""

    def __init__(self, srv, session, stop):
        self.srv, self.session, self.stop = srv, session, stop
        self.lease = None

    def close(self):
        for s in (self.lease, self.srv):
            if s is not None:
                try:
                    s.close()
                except OSError:
                    pass
        self.lease = self.srv = None

    def close_listener(self):
        """Stop accepting requests; the lease (if any) stays open so a failure can still be reported on it."""
        if self.srv is not None:
            try:
                self.srv.close()
            except OSError:
                pass

    def pump(self, timeout=0.2, allow_lease=False, watch_lease=True):
        """Service the sockets for up to `timeout`. Returns (connection, pid) for a new lease request when
        `allow_lease`; raises Cancelled when the lease closed or a stop was requested."""
        if self.stop:
            raise Cancelled("the backend was asked to stop")
        socks = [self.srv]
        if watch_lease and self.lease is not None:
            socks.append(self.lease)
        r, _, _ = select.select(socks, [], [], timeout)
        if watch_lease and self.lease is not None and self.lease in r:
            if not self.lease.recv(1, socket.MSG_PEEK):
                raise Cancelled("the lease closed")  # EOF: plugin disabled/unloaded or shell gone
            self.lease.recv(4096)
        if self.srv in r:
            return self.accept(allow_lease)
        return None

    def accept(self, allow_lease):
        conn, _ = self.srv.accept()
        s = self.session
        try:
            pid, uid, _ = peer_credentials(conn)
            if uid != os.getuid():
                conn.close()
                return None
            op = read_line(conn, 2.0).get("op")
        except (OSError, ValueError, KeyError, AttributeError):
            conn.close()
            return None
        if op == "lease":
            if self.lease is not None or not allow_lease:
                reply(conn, False, s.active, "a lease is already held")
                conn.close()
                return None
            return conn, pid
        if op == "active":
            reply(conn, True, s.active)
        elif op in ("reload", "toggle"):
            if s.active and s.signal_notch(signal.SIGUSR2 if op == "reload" else signal.SIGUSR1):
                reply(conn, True, True)
            else:
                reply(conn, False, s.active, "plugin is not active")
        elif op == "stop":
            reply(conn, True, False)
            self.stop.append(1)
        else:
            reply(conn, False, s.active, "unknown operation")
        conn.close()
        return None


def terminate_group(proc, grace=STOP_WAIT):
    """Stop a tracked child's own process group (SIGTERM, then SIGKILL) and reap it. Never touches another group."""
    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 5.0)):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            break
        try:
            proc.wait(wait)
            if sig == signal.SIGKILL:
                break
        except subprocess.TimeoutExpired:
            continue
    try:
        proc.wait(5.0)
    except subprocess.TimeoutExpired:
        pass


def provision(checkout, ctl, wait=PROVISION_WAIT):
    """Run `install.sh --provision` for this checkout in its own process group while the native desktop stays untouched.
    The lease and control socket keep being serviced; a closed lease, a stop or a signal cancels it and kills only
    this group. Raises PluginError unless it exits 0."""
    validate_checkout(checkout)  # the checkout may have been deleted since `start`
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", WAYBAR_PILL_SESSION="1")
    logfd = open_provision_log()
    try:
        os.write(logfd, ("== provisioning %s ==\n" % time.strftime("%Y-%m-%d %H:%M:%S")).encode())
        proc = subprocess.Popen(["bash", os.path.join(checkout, "install.sh"), "--provision"], cwd=checkout, env=env,
                                stdin=subprocess.DEVNULL, stdout=logfd, stderr=subprocess.STDOUT, start_new_session=True)
    finally:
        os.close(logfd)
    end = time.monotonic() + wait
    try:
        while proc.poll() is None:
            ctl.pump(0.2)
            if time.monotonic() > end:
                raise PluginError("provisioning did not finish within %d seconds; see %s" % (wait, provision_log_path()))
        if proc.returncode != 0:
            raise PluginError("provisioning failed (exit status %d); see %s" % (proc.returncode, provision_log_path()))
    finally:
        terminate_group(proc)


def establish(ctl, conn, pid, session, provisioner):
    """Provision (when asked), then take the desktop over for the lease peer `pid`."""
    if provisioner is not None:
        try:
            conn.sendall((json.dumps({"ok": True, "active": False, "stage": "provisioning"}) + "\n").encode())
        except OSError:
            raise Cancelled("the lease closed")
        provisioner(ctl)
    session.idle = ctl.pump
    try:
        session.activate(pid, lambda: relay_handshake(conn, session, service=lambda: ctl.pump(0.0, watch_lease=False)))
    finally:
        session.idle = None
    reply(conn, True, True)


def serve(runner=run, popen=subprocess.Popen, checkout=None, state=None, provisioner=None):
    """The detached backend. With a `checkout` it provisions that checkout once the QML service holds the lease; the
    `state` helper (default: the one beside this script) is imported before any lease is accepted."""
    lock = lock_runtime()
    if lock is None:
        return 0  # another backend owns this runtime; never a second product pair
    path = sock_path()
    session = Session(runner, popen)
    session.checkout = checkout
    srv = None
    ctl = None
    stop = []

    def shutdown_listener():
        if ctl is not None:
            ctl.close_listener()
        elif srv is not None:
            srv.close()
        try:
            os.unlink(path)
        except OSError:
            pass

    session.before_restore = shutdown_listener
    try:
        for sig in (signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, lambda *_: stop.append(1))
    except ValueError:
        pass  # not the main thread (embedded use); the caller owns signals
    try:
        session.state = state if state is not None else load_state_module()
        if not restore_everything(session):  # every enable first finishes a stale or manual setup
            session.cleaned = True  # nothing of this session exists yet; do not retry on the way out
            raise PluginError("a previous setup could not be fully restored; nothing was started")
        if os.path.lexists(path):
            if not stat.S_ISSOCK(os.lstat(path).st_mode):
                raise PluginError("%s is not a socket" % path)
            os.unlink(path)  # the flock proves no live backend owns it
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)
        try:
            srv.bind(path)
        finally:
            os.umask(old)
        srv.listen(4)
        ctl = Control(srv, session, stop)
        if provisioner is None and checkout is not None:
            provisioner = lambda c: provision(checkout, c)
        deadline = time.monotonic() + LEASE_WAIT
        while not stop:
            if ctl.lease is None and time.monotonic() > deadline:
                return 0
            try:
                got = ctl.pump(0.2, allow_lease=ctl.lease is None)
            except Cancelled:
                break  # lease EOF (plugin disabled/removed, shell gone) or a stop request
            if session.children and not stop:
                try:
                    session.check_children()
                except PluginError as e:
                    print("waybar-pill-plugin: " + str(e), file=sys.stderr)
                    break
            if got:
                conn, pid = got
                ctl.lease = conn
                try:
                    establish(ctl, conn, pid, session, provisioner)
                except Cancelled:
                    break
                except PluginError as e:
                    print("waybar-pill-plugin: " + str(e), file=sys.stderr)
                    reply(conn, False, False, str(e))
                    break
        return 0
    except PluginError as e:
        print("waybar-pill-plugin: " + str(e), file=sys.stderr)
        return 1
    finally:
        # Stop answering first: a launcher that probes now must see a backend that is going away, not a live one.
        shutdown_listener()
        if ctl is not None:
            ctl.close()
        try:
            session.cleanup()  # children, sockets, managed files, Hyprland, then the native desktop
        finally:
            os.close(lock)


def live_backend(timeout=1.0):
    """Whether a backend currently answers on the control socket; a socket that accepts but never replies, or that is
    being torn down, is not a live backend."""
    try:
        r = request("active", timeout)
    except PluginError:
        return False
    return isinstance(r, dict) and r.get("ok") is True


def spawn_backend(gen, checkout):
    fd = open_provision_log(rotate=True)
    try:
        return subprocess.Popen([sys.executable, os.path.join(gen, "scripts", "waybar-pill-plugin"), "serve", "--checkout", checkout],
                                cwd="/", start_new_session=True, stdin=subprocess.DEVNULL, stdout=fd, stderr=fd,
                                env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"))
    finally:
        os.close(fd)


def start(checkout, wait=LIFECYCLE_WAIT):
    """Launcher for the QML service: validate the checkout, stage the immutable generation, and make sure exactly one
    backend is live. A tearing-down backend is waited for (its runtime lock), never reported as ready; concurrent
    launchers converge on the same live backend."""
    files = validate_checkout(checkout)
    gen = stage_generation(files)
    runtime_dir()
    deadline = time.monotonic() + wait
    child = None
    while True:
        if live_backend():
            return 0
        if child is not None:
            rc = child.poll()
            if rc is not None:
                if rc != 0:
                    print("waybar-pill-plugin: the backend exited with status %d; see %s" % (rc, provision_log_path()), file=sys.stderr)
                    return 1
                child = None  # it lost the runtime lock to another launcher's backend
        if child is None:
            fd = lock_runtime()
            if fd is not None:
                os.close(fd)
                child = spawn_backend(gen, checkout)
        if time.monotonic() > deadline:
            print("waybar-pill-plugin: no backend became ready within %d seconds (a previous session may still be shutting "
                  "down); see %s" % (wait, provision_log_path()), file=sys.stderr)
            return 1
        time.sleep(0.1)


def recover():
    """Restore a stale session's files, then its native desktop, under the runtime lock."""
    fd = lock_runtime()
    if fd is None:
        print("waybar-pill-plugin: a live backend owns the session; disable the plugin instead", file=sys.stderr)
        return 75
    try:
        return 0 if restore_everything(Session(state=load_state_module())) else 1
    finally:
        os.close(fd)


def control(op):
    r = request(op)
    if r is None:
        return 1
    if not r.get("ok"):
        print("waybar-pill-plugin: " + r.get("error", "failed"), file=sys.stderr)
        return 1
    return 0


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    c = argv[0]
    if c == "mode" and len(argv) == 1:
        print(mode())
        return 0
    if c == "validate-checkout" and len(argv) == 2:
        validate_checkout(argv[1])
        return 0
    if c == "active" and len(argv) == 1:
        if read_marker() is None:
            return 1
        r = request("active", 1.0)
        return 0 if r and r.get("active") else 1
    if c == "toggle" and len(argv) == 1:
        # active session: toggle the owned supervisor; otherwise the native Omarchy bar
        if read_marker() is not None:
            r = request("active", 1.0)
            if r and r.get("active"):
                return control("toggle")
        return subprocess.run(["omarchy", "toggle", "bar"]).returncode
    if c in ("reload", "stop") and len(argv) == 1:
        return control(c)
    if c == "start" and len(argv) == 3 and argv[1] == "--checkout":
        return start(argv[2])
    if c == "serve" and len(argv) == 3 and argv[1] == "--checkout":
        return serve(checkout=argv[2])
    if c == "recover" and len(argv) == 1:
        return recover()
    if c == "runtime-dir" and len(argv) == 1:
        print(runtime_dir())
        return 0
    if c == "purge-credentials" and argv[1:] in ([], ["--check"]):
        purge_credentials(check_only=bool(argv[1:]))
        return 0
    if c == "record-generated" and len(argv) > 1:
        record_generated_files(argv[1:])
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except PluginError as e:
        print("waybar-pill-plugin: " + str(e), file=sys.stderr)
        sys.exit(1)
