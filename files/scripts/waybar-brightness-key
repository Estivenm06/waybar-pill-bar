#!/bin/bash
# Brightness keys. Usage: waybar-brightness-key +5%|5%-|100%|1%
# Plugin session active: change brightness silently, then show the notch overlay.
# Otherwise (inactive or not set up): native Omarchy behavior, including its own OSD.
D="$(dirname "$0")"
if ! python3 "$D/waybar-pill-plugin" active; then
  exec omarchy-brightness-display "$1"
fi
omarchy-brightness-display --no-osd "$1"
exec "$D/waybar-popupctl" osd-brightness
