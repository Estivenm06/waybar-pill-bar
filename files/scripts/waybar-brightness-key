#!/bin/bash
# Brightness keys. Usage: waybar-brightness-key +5%|5%-|100%|1%
# Standalone or plugin active: change brightness silently, then show the notch overlay.
# Plugin installed but inactive: native Omarchy behavior, including its own OSD.
D="$(dirname "$0")"
if [ "$(python3 "$D/waybar-pill-plugin" mode)" = plugin ] && ! python3 "$D/waybar-pill-plugin" active; then
  exec omarchy-brightness-display "$1"
fi
omarchy-brightness-display --no-osd "$1"
exec "$D/waybar-popupctl" osd-brightness
