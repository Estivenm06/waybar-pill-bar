{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 4,
  "margin-top": 0,
  "margin-left": 6,
  "margin-right": 6,
  "margin-bottom": 0,
  "exclusive": true,
  "modules-left": [
    "group/left"
  ],
  "modules-center": [],
  "modules-right": [
    "group/right"
  ],
  "clock": {
    "format": "__CLOCK_FMT__",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span color='#ffffff'><b>{}</b></span>"
      }
    },
    "tooltip": false,
    "on-click": "__HOME__/.config/waybar/scripts/waybar-popupctl calendar"
  },
  "custom/launcher": {
    "format": "\uf303",
    "tooltip": false,
    "on-click": "omarchy-menu"
  },
  "custom/capture": {
    "format": "\uf030",
    "tooltip": true,
    "tooltip-format": "Take Screenshot",
    "on-click": "sh -c 'sleep 0.6; omarchy screenshot'"
  },
  "custom/screenrecord": {
    "format": "\uf03d",
    "tooltip": true,
    "tooltip-format": "Start/Stop Screen Recording",
    "on-click": "sh -c 'sleep 0.6; omarchy screenrecord'"
  },
  "custom/notifications": {
    "format": "{}",
    "return-type": "json",
    "interval": 2,
    "exec": "if grep -q '\"dnd\": true' \"$HOME/.local/state/omarchy/notifications.json\" 2>/dev/null; then echo '{\"text\":\"\\U000f0714\",\"class\":\"muted\",\"tooltip\":\"Notifications: Silenced (DND)\"}'; else echo '{\"text\":\"\\U000f00ed\",\"class\":\"normal\",\"tooltip\":\"Notifications: Active\"}'; fi",
    "on-click": "f=\"$HOME/.local/state/omarchy/notifications.json\"; if grep -q '\"dnd\": true' \"$f\" 2>/dev/null; then v=false; else v=true; fi; printf '{\\n  \"version\": 3,\\n  \"dnd\": %s\\n}\\n' \"$v\" > \"$f\""
  },
  "custom/nightlight": {
    "format": "{}",
    "return-type": "json",
    "interval": 2,
    "exec": "if omarchy toggle nightlight --status | jq -e '.enabled' >/dev/null 2>/dev/null; then echo '{\"text\":\"\\U000f02d7\",\"class\":\"active\",\"tooltip\":\"Reading Mode: ON\"}'; else echo '{\"text\":\"\\U000f02d6\",\"class\":\"inactive\",\"tooltip\":\"Reading Mode: OFF\"}'; fi",
    "on-click": "omarchy toggle nightlight"
  },
  "custom/search": {
    "format": "\uf002",
    "tooltip": false,
    "on-click": "omarchy-menu"
  },
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": false
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-es": "ES",
    "keyboard-name": "at-translated-set-2-keyboard",
    "on-click": "hyprctl switchxkblayout all next"
  },
  "bluetooth": {
    "format": "\uf293",
    "format-disabled": "\udb80\udcb2",
    "format-connected": "\uf293 {num_connections}",
    "tooltip": true,
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
    "on-click": "__HOME__/.config/waybar/scripts/waybar-popupctl bluetooth",
    "format-off": "\udb80\udcb2"
  },
  "network": {
    "interface": "wl*",
    "rfkill": true,
    "interval": 60,
    "format": "\uf1eb",
    "format-wifi": "\uf1eb",
    "format-linked": "\uf1eb",
    "format-disconnected": "\uf1eb",
    "format-disabled": "\udb82\udd2e",
    "tooltip": true,
    "tooltip-format": "Wi-Fi offline",
    "tooltip-format-wifi": "{essid}",
    "tooltip-format-disconnected": "Wi-Fi offline",
    "tooltip-format-disabled": "Wi-Fi off",
    "on-click": "__HOME__/.config/waybar/scripts/waybar-popupctl wifi"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "\uf025 {desc}",
    "tooltip-format": "{desc} · {volume}%",
    "max-length": 24,
    "format-muted": "\udb81\udf5f",
    "format-icons": {
      "default": [
        "\uf026",
        "\uf027",
        "\uf028"
      ]
    },
    "on-click": "__HOME__/.config/waybar/scripts/waybar-popupctl volume",
    "on-scroll-up": "pamixer -i 5",
    "on-scroll-down": "pamixer -d 5",
    "tooltip": true
  },
  "battery": {
    "states": {
      "warning": 25,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "\uf0e7 {capacity}%",
    "format-icons": [
      "\uf244",
      "\uf243",
      "\uf242",
      "\uf241",
      "\uf240"
    ],
    "tooltip": false,
    "on-click": "__HOME__/.config/waybar/scripts/waybar-popupctl battery",
    "format-plugged": "\uf1e6 {capacity}%",
    "format-not-charging": "\uf1e6 {capacity}%"
  },
  "custom/media": {
    "exec": "__HOME__/.config/waybar/scripts/media-follow.py",
    "return-type": "json",
    "escape": true,
    "tooltip": false,
    "on-click": "playerctl -p spotify,%any play-pause",
    "on-click-right": "playerctl -p spotify,%any next",
    "on-click-middle": "playerctl -p spotify,%any previous",
    "on-scroll-up": "playerctl -p spotify,%any next",
    "on-scroll-down": "playerctl -p spotify,%any previous"
  },
  "custom/display": {
    "exec": "n=$(hyprctl monitors -j | jq length); if [ \"$n\" -gt 1 ]; then printf '{\"text\":\"\\U000f037a\"}\\n'; else printf '{\"text\":\"\\U000f0379\"}\\n'; fi",
    "return-type": "json",
    "interval": 5,
    "tooltip": false,
    "on-click": "__HOME__/.config/waybar/scripts/waybar-popupctl display"
  },
  "image#art": {
    "exec": "__HOME__/.config/waybar/scripts/media-art.py",
    "size": 20,
    "interval": 2,
    "on-click": "playerctl -p spotify,%any play-pause"
  },
  "custom/eq": {
    "exec": "__HOME__/.config/waybar/scripts/media-eq.py",
    "return-type": "json",
    "tooltip": false,
    "on-click": "playerctl -p spotify,%any play-pause"
  },
  "group/notch": {
    "orientation": "horizontal",
    "modules": [
      "image#art",
      "custom/media",
      "custom/eq"
    ]
  },
  "group/left": {
    "orientation": "horizontal",
    "modules": [
      "custom/launcher",
      "hyprland/workspaces",
      "group/apps"
    ]
  },
  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "group/status",
      "clock"
    ]
  },
  "group/status": {
    "orientation": "horizontal",
    "spacing": 0,
    "modules": [
      "bluetooth",
      "network",
      "pulseaudio",
      "battery"
    ]
  },
  "group/apps": {
    "orientation": "horizontal",
    "modules": []
  }
}