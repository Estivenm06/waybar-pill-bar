[Unit]
Description=Waybar notch (expanding media / calendar / clipboard notch, Rust)
PartOf=graphical-session.target
After=graphical-session.target waybar.service
Requisite=graphical-session.target

[Service]
ExecStart=%h/.local/bin/waybar-notch
UnsetEnvironment=GDK_SCALE GDK_DPI_SCALE
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
